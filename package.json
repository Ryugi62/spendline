{
  "name": "spendline",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Receipts for AI spending: a policy vault on TRON Nile that pays only inside the line the user drew, records every stop on-chain, and lets anyone audit from receipts alone. Agent runs on Kiln (Qwen3-32B).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "layers": "node scripts/check-layers.mjs",
    "compile:contract": "node scripts/compile-contract.mjs",
    "smoke:kiln": "tsx scripts/smoke-kiln.ts",
    "smoke:nile": "tsx scripts/smoke-nile.ts",
    "video": "tsx scripts/record-video.mjs",
    "audit": "tsx src/infrastructure/audit-cli.ts",
    "ui": "vite web",
    "ui:build": "vite build web",
    "ui:data": "tsx scripts/ui-data.ts",
    "ui:capture": "tsx scripts/capture-ui.ts",
    "explain": "tsx src/infrastructure/answers-cli.ts explain",
    "dispute": "tsx src/infrastructure/answers-cli.ts dispute",
    "grant": "tsx src/infrastructure/owner-cli.ts grant",
    "stop": "tsx src/infrastructure/owner-cli.ts stop",
    "agent": "tsx src/infrastructure/agent-cli.ts",
    "report": "tsx scripts/report.ts",
    "ab:no-think": "tsx scripts/ab-no-think.ts",
    "video:stage": "tsx scripts/video-stage.ts",
    "deck": "tsx scripts/deck.ts",
    "ab:tool-call": "tsx scripts/ab-tool-call.ts",
    "chain:cost": "tsx scripts/chain-cost.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "playwright": "^1.57.0",
    "solc": "^0.8.30",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "tronweb": "^6.5.1"
  }
}
